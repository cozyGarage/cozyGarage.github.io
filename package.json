{
  "name": "portfolio",
  "version": "1.0.0",
  "homepage": "https://cozygarage.github.io/",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d dist",
    "validate": "bun run type-check && bun run test",
    "optimize-images": "bun ./scripts/optimize-images.js",
    "analyze:bundle": "bunx source-map-explorer 'dist/assets/*.js' --html dist/index-explorer.html",
    "audit:lighthouse": "bunx lighthouse https://cozygarage.github.io --output json --output-path=./lighthouse.json --chrome-flags='--headless' --quiet",
    "clean": "rm -rf node_modules dist .turbo .cache",
    "admin": "bun run ./admin/server.ts",
    "admin:dev": "bun run --watch ./admin/server.ts",
    "dev:all": "bun run dev & bun run admin"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.11.1",
    "lighthouse": "^13.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "source-map-explorer": "^2.5.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.4"
  }
}
