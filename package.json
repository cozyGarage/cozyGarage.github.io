{
  "name": "portfolio",
  "version": "1.0.0",
  "homepage": "https://cozygarage.github.io/",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d dist",
    "validate": "bun run type-check && bun run test",
    "optimize-images": "bun ./scripts/optimize-images.js",
    "analyze:bundle": "bunx source-map-explorer 'dist/assets/*.js' --html dist/index-explorer.html",
    "audit:lighthouse": "bunx lighthouse https://cozygarage.github.io --output json --output-path=./lighthouse.json --chrome-flags='--headless' --quiet",
    "clean": "rm -rf node_modules dist .turbo .cache"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^12.10.3",
    "jsdom": "^27.0.1",
    "lighthouse": "^13.0.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "source-map-explorer": "^2.5.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
